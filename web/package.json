{
  "name": "greenokra",
  "version": "0.1.0",
  "description": "Validator and editor for GreenOKRa OKR files",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "node src/bin.ts check",
    "show": "node src/bin.ts show",
    "dev": "npm run copy:example && next dev",
    "build": "npm run copy:example && next build",
    "copy:example": "node --eval \"require('node:fs').copyFileSync('../okrs/2026.yaml','public/example.yaml')\""
  },
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "lucide-react": "^1.38.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "bin": {
    "greenokra": "./src/bin.ts"
  },
  "engines": {
    "node": ">=23.6"
  }
}
